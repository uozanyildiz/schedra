{
  "name": "@schedra/core",
  "private": true,
  "version": "0.1.0",
  "description": "Framework-independent engine for large canvas-based Gantt timelines.",
  "type": "module",
  "license": "MIT",
  "author": "Uğur Ozan Yıldız",
  "homepage": "https://github.com/uozanyildiz/schedra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uozanyildiz/schedra.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/uozanyildiz/schedra/issues"
  },
  "keywords": [
    "gantt",
    "timeline",
    "canvas",
    "virtualization",
    "scheduler"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
